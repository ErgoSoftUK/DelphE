all: src/Preview src/designer/Designer tools/GenTest tools/MainFormBuilt tools/PenTest tools/Bench dunit/SelfTest tests/Tests
  echo "compiled"

runtests: dunit/SelfTest tests/Tests tools/GenTest
  cd tools
  GenTest > /gentest.out
  cd /dunit
  SelfTest > /tests.out
  cd /tests
  Tests >> /tests.out
  cd /

src/formmodel.m: src/FormModel.e
