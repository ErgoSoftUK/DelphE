; Build the DelphE modules and programs, then the generator smoke test.
; Run from the DelphE drawer:  execute Build
echo "Building.." > build.out
cd src
ec FormModel >> /build.out
ec MForm >> /build.out
ec Util >> /build.out
ec Generator >> /build.out
ec UserFile >> /build.out
ec Project >> /build.out
ec Highlight >> /build.out
ec Builder >> /build.out
ec Preview >> /build.out
ec mcc/Listtree_mcc >> /build.out
ec mcc/TextEditor_MCC >> /build.out
ec mcc/Toolbar_mcc >> /build.out
ec designer/Designer >> /build.out
cd /tools
ec GenTest >> /build.out
GenTest > /gentest.out
ec MainFormBuilt >> /build.out
ec PenTest >> /build.out
ec Bench >> /build.out
cd /
type build.out
