; Compile and run only the tests, with E-VO. The modules must be up to date: Build does that.
; Run from the DelphE drawer:  execute RunTestsEvo
; The compiler output goes to tests.log, the test report to tests.out.
echo "Compiling the tests.." > tests.log
cd dunit
evo DUnit NOPROGRESS ADDBUF 3 >> /tests.log
evo SelfTest NOPROGRESS ADDBUF 3 >> /tests.log
SelfTest > /tests.out
cd /tests
evo Tests NOPROGRESS ADDBUF 3 >> /tests.log
Tests >> /tests.out
cd /
type tests.out
