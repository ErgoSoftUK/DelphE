/*
** DelphE code generator
**
** Turns a form model (see FormModel.e) into an E source unit.
**
** The unit declares an OBJECT holding the handle of every named component,
** and a create() method that builds the real MUI objects. Leaf widgets are
** created first (so they can be named); groups and the window are then
** assembled around them, in the same style as hand-written MUI E code.
*/

OPT MODULE
OPT EXPORT

MODULE '*FormModel'

PROC put(fh, s) IS Write(fh, s, StrLen(s))

PROC indent(fh, depth)
  DEF i
  FOR i := 1 TO depth DO put(fh, '  ')
ENDPROC

-> E strings are single-quoted; \a is an apostrophe
PROC quoted(fh, s)
  put(fh, '\a')
  put(fh, s)
  put(fh, '\a')
ENDPROC

/*** pass 1: fields ***/

PROC declareLeaves(fh, c: PTR TO component)
  DEF ch: PTR TO component
  IF isContainer(c.kind) = FALSE
    put(fh, '  ')
    put(fh, c.name)
    put(fh, '\n')
  ENDIF
  ch := c.firstChild
  WHILE ch
    declareLeaves(fh, ch)
    ch := ch.next
  ENDWHILE
ENDPROC

/*** pass 2: leaf widgets ***/

PROC leafExpr(fh, c: PTR TO component)
  DEF kind
  kind := c.kind
  SELECT kind
    CASE CK_BUTTON
      put(fh, 'SimpleButton(')
      quoted(fh, c.title)
      put(fh, ')')
    CASE CK_TEXT
      put(fh, 'TextObject, TextFrame, MUIA_Text_Contents, ')
      quoted(fh, c.title)
      put(fh, ', End')
    CASE CK_STRING
      put(fh, 'StringObject, StringFrame, MUIA_String_Contents, ')
      quoted(fh, c.title)
      put(fh, ', End')
    CASE CK_CHECK
      put(fh, 'CheckMark(FALSE)')
  ENDSELECT
ENDPROC

PROC createLeaves(fh, c: PTR TO component, formName)
  DEF ch: PTR TO component
  IF isContainer(c.kind) = FALSE
    put(fh, '  self.')
    put(fh, c.name)
    put(fh, ' := ')
    leafExpr(fh, c)
    put(fh, '\n')
  ENDIF
  ch := c.firstChild
  WHILE ch
    createLeaves(fh, ch, formName)
    ch := ch.next
  ENDWHILE
ENDPROC

/*** pass 3: containers ***/

-> Emits one expression with no trailing comma; the caller adds it.
PROC containerExpr(fh, c: PTR TO component, depth)
  DEF ch: PTR TO component, kind

  IF isContainer(c.kind) = FALSE
    put(fh, 'self.')
    put(fh, c.name)
    RETURN
  ENDIF

  kind := c.kind
  SELECT kind
    CASE CK_WINDOW
      put(fh, 'WindowObject,\n')
      indent(fh, depth + 1)
      put(fh, 'MUIA_Window_Title, ')
      quoted(fh, c.title)
      put(fh, ',\n')
      indent(fh, depth + 1)
      put(fh, 'MUIA_Window_ID, ')
      quoted(fh, 'MAIN')
      put(fh, ',\n')
      indent(fh, depth + 1)
      put(fh, 'WindowContents,\n')
      ch := c.firstChild
      IF ch
        indent(fh, depth + 2)
        containerExpr(fh, ch, depth + 2)
        put(fh, ',\n')
      ENDIF
    CASE CK_VGROUP
      put(fh, 'VGroup,\n')
      emitChildren(fh, c, depth)
    CASE CK_HGROUP
      put(fh, 'HGroup,\n')
      emitChildren(fh, c, depth)
  ENDSELECT

  indent(fh, depth)
  put(fh, 'End')
ENDPROC

PROC emitChildren(fh, c: PTR TO component, depth)
  DEF ch: PTR TO component
  ch := c.firstChild
  WHILE ch
    indent(fh, depth + 1)
    put(fh, 'Child, ')
    containerExpr(fh, ch, depth + 1)
    put(fh, ',\n')
    ch := ch.next
  ENDWHILE
ENDPROC

/*** entry point ***/

PROC generateUnit(fh, win: PTR TO component)
  put(fh, '/* Generated by DelphE - do not edit */\n\n')
  put(fh, 'OPT MODULE\nOPT EXPORT\nOPT PREPROCESS\n\n')
  put(fh, 'MODULE \amuimaster\a, \alibraries/mui\a, \autility/tagitem\a\n\n')

  -> E reserves capitalised identifiers for constants, so object types get a t prefix
  put(fh, 'OBJECT t')
  put(fh, win.name)
  put(fh, '\n  handle\n')
  declareLeaves(fh, win)
  put(fh, 'ENDOBJECT\n\n')

  put(fh, 'PROC create() OF t')
  put(fh, win.name)
  put(fh, '\n')
  createLeaves(fh, win, win.name)
  put(fh, '  self.handle := ')
  containerExpr(fh, win, 1)
  put(fh, '\nENDPROC\n')
ENDPROC
