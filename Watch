; Build watcher. Start once from the DelphE drawer, in a shell where  execute SetupEvo  has been run:
;   run execute Watch
;
;   build.trigger  create this file to start a build (BuildMake)
;   build.done     written when the build has finished (read build.out then)
;   build.stop     create this file to make the watcher exit
;   tests.trigger  create this file to run only the tests (tests.done when finished)
;
; Each run does one check and then starts a fresh copy of itself, so there is
; no looping (Skip BACK misbehaved after running a script). Progress is logged
; to watch.log.
;
failat 21
if exists build.stop
  delete build.stop
  echo "watcher stopped" >> watch.log
else
  if exists build.trigger
    echo "trigger seen" >> watch.log
    delete build.trigger
    if exists build.done
      delete build.done
    endif
    execute BuildMake
    echo "done" > build.done
    echo "build finished" >> watch.log
  endif
  if exists tests.trigger
    echo "tests trigger seen" >> watch.log
    delete tests.trigger
    if exists tests.done
      delete tests.done
    endif
    execute RunTests
    echo "done" > tests.done
    echo "tests finished" >> watch.log
  endif
  wait 1 sec
  run >NIL: <NIL: execute Watch
endif
