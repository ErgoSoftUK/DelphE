PROC delpheRun() HANDLE
  DEF app = NIL, sigs = 0, id, running

  IF (muimasterbase := OpenLibrary(MUIMASTER_NAME, MUIMASTER_VMIN)) = NIL THEN
    Raise('Failed to open muimaster.library')

  NEW fmKindsDemo
  fmKindsDemo.idBase := 1000
  fmKindsDemo.create()
  IF fmKindsDemo.handle = NIL THEN Raise('Failed to create a window')
  NEW fmDemoSettings
  fmDemoSettings.idBase := 2000
  fmDemoSettings.create()
  IF fmDemoSettings.handle = NIL THEN Raise('Failed to create a window')
  NEW fmDemoMain
  fmDemoMain.idBase := 3000
  fmDemoMain.create()
  IF fmDemoMain.handle = NIL THEN Raise('Failed to create a window')
  NEW fmTest
  fmTest.idBase := 4000
  fmTest.create()
  IF fmTest.handle = NIL THEN Raise('Failed to create a window')

  app := ApplicationObject,
    MUIA_Application_Title      , 'Demo',
    MUIA_Application_Base       , 'DELPHEPROJECT',
    SubWindow, fmKindsDemo.handle,
    SubWindow, fmDemoSettings.handle,
    SubWindow, fmDemoMain.handle,
    SubWindow, fmTest.handle,
  End

  IF app = NIL THEN Raise('Failed to create Application.')
  delpheApp := app

  fmKindsDemo.connect(app)
  fmDemoSettings.connect(app)
  fmDemoMain.connect(app)
  fmTest.connect(app)

  doMethodA(fmKindsDemo.handle, [MUIM_Notify, MUIA_Window_CloseRequest, MUI_TRUE,
    app, 2, MUIM_Application_ReturnID, MUIV_Application_ReturnID_Quit])
  doMethodA(fmDemoSettings.handle, [MUIM_Notify, MUIA_Window_CloseRequest, MUI_TRUE,
    fmDemoSettings.handle, 3, MUIM_Set, MUIA_Window_Open, FALSE])
  doMethodA(fmDemoMain.handle, [MUIM_Notify, MUIA_Window_CloseRequest, MUI_TRUE,
    fmDemoMain.handle, 3, MUIM_Set, MUIA_Window_Open, FALSE])
  doMethodA(fmTest.handle, [MUIM_Notify, MUIA_Window_CloseRequest, MUI_TRUE,
    fmTest.handle, 3, MUIM_Set, MUIA_Window_Open, FALSE])

  fmKindsDemo.show()

  running := TRUE
  WHILE running
    id := doMethodA(app, [MUIM_Application_NewInput, {sigs}])
    IF id = MUIV_Application_ReturnID_Quit
      running := FALSE
    ELSE
      fmKindsDemo.handleEvent(id)
      fmDemoSettings.handleEvent(id)
      fmDemoMain.handleEvent(id)
      fmTest.handleEvent(id)
    ENDIF
    IF running AND sigs THEN sigs := Wait(sigs)
  ENDWHILE

  fmKindsDemo.hide()
  fmDemoSettings.hide()
  fmDemoMain.hide()
  fmTest.hide()

EXCEPT DO
  IF app THEN Mui_DisposeObject(app)
  IF muimasterbase THEN CloseLibrary(muimasterbase)
  IF exception THEN WriteF('\s\n', exception)
ENDPROC
->>> DELPHE END project |

